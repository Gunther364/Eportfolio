{% extends "base.html.twig" %}

{% block title %}SAE 1.03 - Connecter : WiFi, câblage et communication{% endblock %}

{% block body %}

<style>
  .sae-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 60px 20px 80px;
  }

  .sae-hero {
    text-align: center;
    margin-bottom: 50px;
  }

  .sae-tag {
    display: inline-block;
    background: rgba(99,102,241,0.12);
    border: 1px solid rgba(99,102,241,0.3);
    color: #6366f1;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 5px 14px;
    border-radius: 50px;
    margin-bottom: 18px;
  }

  .sae-hero h1 {
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.5px;
    margin-bottom: 0;
  }

  .alert-info {
    background: rgba(6,182,212,0.08) !important;
    border: 1px solid rgba(6,182,212,0.25) !important;
    border-left: 4px solid #06b6d4 !important;
    border-radius: 12px !important;
    color: var(--text-sec) !important;
    padding: 20px 22px !important;
    font-size: 0.92rem;
    line-height: 1.7;
    margin-bottom: 40px;
  }

  .alert-info strong { color: #06b6d4; }

  .section-label {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--text-pri);
    margin: 44px 0 18px;
    letter-spacing: -0.3px;
  }

  .section-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border-col);
  }

  /* ── ÉTAPES ── */
  ol.steps {
    list-style: none;
    padding: 0;
    counter-reset: step-counter;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  ol.steps > li {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    background: var(--bg-card);
    border: 1px solid var(--border-col);
    border-radius: 12px;
    padding: 16px 18px;
    font-size: 0.9rem;
    color: var(--text-sec);
    line-height: 1.65;
    transition: border-color 0.25s, transform 0.25s;
    counter-increment: step-counter;
  }

  ol.steps > li:hover {
    border-color: var(--border-hover);
    transform: translateX(4px);
  }

  ol.steps > li::before {
    content: counter(step-counter);
    min-width: 28px;
    height: 28px;
    border-radius: 8px;
    background: linear-gradient(135deg, #6366f1, #06b6d4);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 1px;
  }

  ol.steps > li strong { color: var(--text-pri); }

  ol.steps ul {
    margin: 8px 0 0 4px;
    padding-left: 16px;
    list-style: disc;
    font-size: 0.85rem;
  }

  ol.steps ul li { margin-bottom: 3px; }

  /* ── ACCORDION ── */
  .accordion-item {
    background: var(--bg-card) !important;
    border: 1px solid var(--border-col) !important;
    border-radius: 12px !important;
    margin-bottom: 8px;
    overflow: hidden;
    transition: border-color 0.25s;
  }

  .accordion-item:hover { border-color: var(--border-hover) !important; }

  .accordion-button {
    background: var(--bg-card) !important;
    color: var(--text-pri) !important;
    font-weight: 600;
    font-size: 0.9rem;
    box-shadow: none !important;
    border: none !important;
  }

  .accordion-button:not(.collapsed) {
    background: rgba(99,102,241,0.07) !important;
    color: #6366f1 !important;
  }

  .accordion-button::after {
    filter: invert(40%) sepia(100%) saturate(500%) hue-rotate(210deg);
  }

  .accordion-body {
    background: var(--bg-card) !important;
    padding: 14px 20px 18px !important;
    border-top: 1px solid var(--border-col);
  }

  .accordion-body .btn-outline-primary,
  .accordion-body .btn-outline-secondary {
    border-radius: 8px;
    font-size: 0.82rem;
    font-weight: 600;
    padding: 6px 14px;
    transition: all 0.25s;
  }

  .accordion-body .btn-outline-primary:hover,
  .accordion-body .btn-outline-secondary:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(0,0,0,0.2);
  }

  /* ── LISTES STYLED ── */
  ul.styled-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  ul.styled-list li {
    background: var(--bg-card);
    border: 1px solid var(--border-col);
    border-radius: 10px;
    padding: 13px 16px 13px 44px;
    font-size: 0.89rem;
    color: var(--text-sec);
    line-height: 1.6;
    position: relative;
    transition: border-color 0.25s, transform 0.25s;
  }

  ul.styled-list li:hover {
    border-color: var(--border-hover);
    transform: translateX(4px);
  }

  ul.styled-list li::before {
    content: '→';
    position: absolute;
    left: 16px;
    color: #6366f1;
    font-weight: 700;
  }

  /* ── NOTATION ── */
  .notation-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  @media (max-width: 600px) {
    .notation-grid { grid-template-columns: 1fr; }
  }

  .notation-card {
    background: var(--bg-card);
    border: 1px solid var(--border-col);
    border-radius: 14px;
    padding: 22px 20px;
    transition: border-color 0.25s, transform 0.25s;
  }

  .notation-card:hover {
    border-color: var(--border-hover);
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(0,0,0,0.2);
  }

  .notation-card h6 {
    font-weight: 800;
    font-size: 0.9rem;
    margin-bottom: 14px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .notation-card h6 .score-badge {
    margin-left: auto;
    background: linear-gradient(135deg, #6366f1, #06b6d4);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 50px;
  }

  .notation-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 7px 0;
    border-bottom: 1px solid var(--border-col);
    font-size: 0.83rem;
    color: var(--text-sec);
    gap: 10px;
  }

  .notation-row:last-child { border-bottom: none; }

  .notation-row .pts {
    flex-shrink: 0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    color: #6366f1;
    font-weight: 700;
  }

  /* ── BOUTON RETOUR ── */
  .btn-retour {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 28px;
    border-radius: 12px;
    background: linear-gradient(135deg, #6366f1, #06b6d4);
    color: #fff !important;
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
    border: none;
    transition: all 0.25s;
    box-shadow: 0 4px 20px rgba(99,102,241,0.3);
  }

  .btn-retour:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 30px rgba(99,102,241,0.45);
    color: #fff !important;
  }
</style>

<div class="sae-page">

  <!-- HERO -->
  <div class="sae-hero" data-aos="fade-up">
    <div class="sae-tag">SAE 1.03</div>
    <h1>🔌 Connecter : WiFi, câblage<br>et communication</h1>
  </div>

  <!-- ALERT -->
  <div class="alert alert-info" data-aos="fade-up" data-aos-delay="80">
    <strong>Durée :</strong> 24 heures<br>
    <strong>Objectif :</strong> Mesurer, déployer et justifier des solutions de connectivité réseau dans un contexte professionnel.
  </div>

  <!-- PROJETS -->
  <div class="section-label" data-aos="fade-up">📚 Projets réalisés</div>
  <ol class="steps" data-aos="fade-up" data-aos-delay="60">
    <li>
      <div>
        <strong>Projet 1 :</strong> Établissement de la couverture WiFi
        <ul>
          <li>Mesures sur le réseau eduroam : AP, Signal Strength, Signal Level, Noise Level, SNR, Channels</li>
          <li>Plans zonés par couleur (du vert au rouge)</li>
          <li>Courbes de couverture WiFi et choix d'un indicateur fiable</li>
          <li>Présentation en anglais du travail réalisé</li>
        </ul>
      </div>
    </li>
    <li>
      <div>
        <strong>Projet 2 :</strong> Devis pour la salle réseaux G007
        <ul>
          <li>Choix du matériel passif dans le catalogue LEGRAND</li>
          <li>Justification technique : baie de brassage, panneaux, noyaux, goulottes, câbles, prises RJ45</li>
          <li>Présentation en anglais du devis et comparaison des offres</li>
        </ul>
      </div>
    </li>
    <li>
      <div>
        <strong>Projet 3 :</strong> Recettage du câblage de la salle G007
        <ul>
          <li>Tests de conformité entre répartiteurs B et C et les tables de travail</li>
          <li>Vérification de la continuité et mesures techniques : longueur, type, débit</li>
          <li>Plan de câblage avec numéros de prises</li>
          <li>Présentation en anglais de la démarche de recettage</li>
        </ul>
      </div>
    </li>
  </ol>

  <!-- COMPÉTENCES -->
  <div class="section-label" data-aos="fade-up">🧠 Compétences évaluées</div>

  <div class="accordion" id="accordionAC" data-aos="fade-up" data-aos-delay="60">

    <div class="accordion-item">
      <h2 class="accordion-header" id="headingAC0211">
        <button class="accordion-button collapsed" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#collapseAC0211"
                aria-expanded="false"
                aria-controls="collapseAC0211">
          AC0211 — Mesurer et analyser les signaux
        </button>
      </h2>
      <div id="collapseAC0211" class="accordion-collapse collapse"
           aria-labelledby="headingAC0211" data-bs-parent="#accordionAC">
        <div class="accordion-body">
          <a href="#" class="btn btn-outline-primary btn-sm me-2" target="_blank" rel="noopener noreferrer">Preuve</a>
          <a href="#" class="btn btn-outline-secondary btn-sm" target="_blank" rel="noopener noreferrer">Analyse réflexive</a>
        </div>
      </div>
    </div>

    <div class="accordion-item">
      <h2 class="accordion-header" id="headingAC0213">
        <button class="accordion-button collapsed" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#collapseAC0213"
                aria-expanded="false"
                aria-controls="collapseAC0213">
          AC0213 — Déployer des supports de transmission
        </button>
      </h2>
      <div id="collapseAC0213" class="accordion-collapse collapse"
           aria-labelledby="headingAC0213" data-bs-parent="#accordionAC">
        <div class="accordion-body">
          <a href="#" class="btn btn-outline-primary btn-sm me-2" target="_blank" rel="noopener noreferrer">Preuve</a>
          <a href="#" class="btn btn-outline-secondary btn-sm" target="_blank" rel="noopener noreferrer">Analyse réflexive</a>
        </div>
      </div>
    </div>

    <div class="accordion-item">
      <h2 class="accordion-header" id="headingAC0215">
        <button class="accordion-button collapsed" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#collapseAC0215"
                aria-expanded="false"
                aria-controls="collapseAC0215">
          AC0215 — Communiquer avec un client ou un collaborateur
        </button>
      </h2>
      <div id="collapseAC0215" class="accordion-collapse collapse"
           aria-labelledby="headingAC0215" data-bs-parent="#accordionAC">
        <div class="accordion-body">
          <a href="https://docs.google.com/document/d/107xXkJoqq0NDpImRjDqgiCNmbeaTXDFDFlM5nhnIjAs/edit?usp=sharing"
             class="btn btn-outline-primary btn-sm me-2"
             target="_blank" rel="noopener noreferrer">Preuve</a>
          <a href="https://docs.google.com/document/d/133EkEJPjBfuCyYd187wi6oA-Ao5q3XpWqdML227X-ag/edit?usp=sharing"
             class="btn btn-outline-secondary btn-sm"
             target="_blank" rel="noopener noreferrer">Analyse réflexive</a>
        </div>
      </div>
    </div>

  </div>

  <!-- CAHIER DES CHARGES -->
  <div class="section-label" data-aos="fade-up">📌 Cahier des charges</div>
  <ul class="styled-list" data-aos="fade-up" data-aos-delay="60">
    <li>Justification complète de toutes les mesures et choix techniques</li>
    <li>Documentation claire et structurée avec tableaux et schémas</li>
    <li>Communication professionnelle en anglais sur chaque projet</li>
    <li>Intégration des pièces justificatives dans le portfolio</li>
  </ul>

  <!-- CRITÈRES DE NOTATION -->
  <div class="section-label" data-aos="fade-up">🗂️ Critères de notation</div>
  <div class="notation-grid" data-aos="fade-up" data-aos-delay="60">

    <div class="notation-card">
      <h6>
        📄 Rapport
        <span class="score-badge">/10</span>
      </h6>
      <div class="notation-row">
        <span>Présentation, mise en forme (sommaire, remerciements, pagination)</span>
        <span class="pts">/2</span>
      </div>
      <div class="notation-row">
        <span>Précision du vocabulaire technique</span>
        <span class="pts">/2</span>
      </div>
      <div class="notation-row">
        <span>Problématique traitée</span>
        <span class="pts">/3</span>
      </div>
      <div class="notation-row">
        <span>Clarté et capacité à convaincre</span>
        <span class="pts">/3</span>
      </div>
    </div>

    <div class="notation-card">
      <h6>
        🎤 Notation orale
        <span class="score-badge">/10</span>
      </h6>
      <div class="notation-row">
        <span>Organisation de la présentation</span>
        <span class="pts">/2</span>
      </div>
      <div class="notation-row">
        <span>Communication</span>
        <span class="pts">/3</span>
      </div>
      <div class="notation-row">
        <span>Résultats complets</span>
        <span class="pts">/3</span>
      </div>
      <div class="notation-row">
        <span>Proposition d'amélioration</span>
        <span class="pts">/2</span>
      </div>
    </div>

  </div>

  <!-- BOUTON RETOUR -->
  <div class="text-center mt-5" data-aos="fade-up">
    <a href="{{ path('app_home') }}" class="btn-retour">
      ← Retour au Portfolio
    </a>
  </div>

</div>

{% endblock %}