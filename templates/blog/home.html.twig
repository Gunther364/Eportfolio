{% block body %}

<style>
  html {
    scroll-behavior: smooth;
  }

  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    margin-top: 80px;
    row-gap: 2rem;
  }

  .hero img {
    max-width: 300px;
    border-radius: 15px;
  }

  .hero .profile-pic {
    width: 250px;
    height: 250px;
    border-radius: 50%;
    object-fit: cover;
  }

  .social-buttons a {
    margin: 5px;
  }

  /* Espacement entre les sections */
  .section-spacing {
    margin-top: 100px;
    margin-bottom: 100px;
  }

  @media (max-width: 768px) {
    .section-spacing {
      margin-top: 60px;
      margin-bottom: 60px;
    }

    .hero {
      margin-top: 40px;
      justify-content: center;
      text-align: center;
    }

    .hero .text-start {
      text-align: center !important;
    }
  }

  /* Style du titre des sections */
  .section-title {
    font-size: 2rem;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 40px;
    position: relative;
  }

  /* Traits décoratifs autour du titre */
  .section-title::before,
  .section-title::after {
    content: "";
    display: inline-block;
    width: 60px;
    height: 2px;
    background-color: #007bff;
    margin: 0 15px;
    vertical-align: middle;
  }

  /* Effet hover sur les cartes */
  .card {
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .card:hover {
    transform: translateY(-5px);
    box-shadow: 0 6px 20px rgba(0,0,0,0.15);
  }

  .card-img-top {
    height: 200px;
    object-fit: cover;
  }

  /* Hauteur mini pour harmoniser les cartes loisirs / projets */
  .card-body-min {
    min-height: 160px;
  }
</style>

