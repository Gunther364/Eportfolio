{% extends "base.html.twig" %}
{% block body %}

<style>
  /* ── VARIABLES LOCALES ── */
  :root {
    --card-radius: 16px;
    --section-gap: 100px;
  }

  /* ── HERO ── */
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    margin-top: 60px;
    row-gap: 2.5rem;
    padding: 60px 0 40px;
  }

  .hero img {
    max-width: 300px;
    border-radius: 15px;
  }

  .hero .profile-pic {
    width: 260px;
    height: 260px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid rgba(99,102,241,0.4);
    box-shadow: 0 0 0 8px rgba(99,102,241,0.08), 0 20px 60px rgba(0,0,0,0.4);
    transition: var(--transition);
  }

  .hero .profile-pic:hover {
    border-color: rgba(99,102,241,0.8);
    box-shadow: 0 0 0 12px rgba(99,102,241,0.12), 0 0 40px rgba(99,102,241,0.3);
    transform: scale(1.03);
  }

  .hero h1 {
    font-weight: 800;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.15;
    letter-spacing: -1px;
  }

  .hero h1 strong {
    background: linear-gradient(135deg, #6366f1, #06b6d4);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero .lead { color: var(--text-sec); font-size: 1.05rem; }
  .hero .mb-3 { color: var(--text-sec); font-size: 0.95rem; }

  .social-buttons a {
    margin: 4px;
    border-radius: 10px !important;
    font-weight: 600;
    font-size: 0.85rem;
    transition: var(--transition) !important;
  }

  .social-buttons a:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0,0,0,0.2);
  }

  /* ── SECTION COMMUNE ── */
  .section-spacing {
    margin-top: var(--section-gap);
    margin-bottom: var(--section-gap);
  }

  @media (max-width: 768px) {
    .section-spacing { margin-top: 60px; margin-bottom: 60px; }
    .hero { margin-top: 20px; justify-content: center; text-align: center; }
    .hero .text-start { text-align: center !important; }
    .social-buttons { justify-content: center; display: flex; flex-wrap: wrap; }
  }

  .section-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 3px;
    margin-bottom: 40px;
    position: relative;
  }

  .section-title::before,
  .section-title::after {
    content: "";
    display: inline-block;
    width: 50px;
    height: 2px;
    background: linear-gradient(90deg, #6366f1, #06b6d4);
    margin: 0 14px;
    vertical-align: middle;
    border-radius: 2px;
  }

  /* ── CARTES GLOBALES ── */
  .card {
    background: var(--bg-card) !important;
    border-color: var(--border-col) !important;
    border-radius: var(--card-radius) !important;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease !important;
  }

  .card:hover {
    transform: translateY(-6px) !important;
    box-shadow: 0 20px 50px rgba(0,0,0,0.3) !important;
    border-color: var(--border-hover) !important;
  }

  .card-title { font-weight: 700; color: var(--text-pri) !important; }
  .card-text { color: var(--text-sec) !important; font-size: 0.88rem; }

  .card-img-top {
    height: 200px;
    object-fit: cover;
    filter: brightness(0.85) saturate(0.9);
    transition: filter 0.4s ease, transform 0.4s ease;
  }

  .card:hover .card-img-top {
    filter: brightness(1) saturate(1.05);
    transform: scale(1.04);
  }

  .card-body-min { min-height: 160px; }

  /* ── BADGE ── */
  .badge {
    padding: 0.6em 1em;
    font-size: 0.85rem;
    font-weight: 600;
    border-radius: 8px !important;
    letter-spacing: 0.3px;
  }

  /* ── ACCORDION ── */
  .accordion-item {
    background: var(--bg-card) !important;
    border: 1px solid var(--border-col) !important;
    border-radius: var(--card-radius) !important;
    overflow: hidden;
    transition: border-color 0.3s;
  }

  .accordion-item:hover { border-color: var(--border-hover) !important; }

  .accordion-button {
    background: var(--bg-card) !important;
    color: var(--text-pri) !important;
    font-weight: 700;
    font-size: 0.95rem;
    border: none !important;
    box-shadow: none !important;
  }

  .accordion-button:not(.collapsed) {
    background: rgba(99,102,241,0.08) !important;
    color: #6366f1 !important;
  }

  .accordion-button::after {
    filter: invert(40%) sepia(100%) saturate(500%) hue-rotate(210deg);
  }

  .accordion-body { background: var(--bg-card) !important; }

  .list-group-item {
    background: transparent !important;
    border-color: var(--border-col) !important;
    color: var(--text-sec) !important;
    font-size: 0.88rem;
    gap: 12px;
  }

  .list-group-item span { flex: 1 1 300px; }
  .btn-group { flex-shrink: 0; }

  /* ── SOFT SKILLS (boutons) ── */
  .btn-outline-primary, .btn-outline-success,
  .btn-outline-info, .btn-outline-warning, .btn-outline-danger {
    border-radius: 10px !important;
    font-weight: 600;
    font-size: 0.83rem;
    transition: var(--transition) !important;
  }

  .btn-outline-primary:hover, .btn-outline-success:hover,
  .btn-outline-info:hover, .btn-outline-warning:hover,
  .btn-outline-danger:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(0,0,0,0.2);
  }

  /* ── SECTION À PROPOS ── */
  #apropos .col-md-8 p {
    color: var(--text-sec);
    font-size: 0.97rem;
    margin-bottom: 1.2rem;
    padding: 18px 20px;
    background: var(--bg-card);
    border: 1px solid var(--border-col);
    border-left: 3px solid #6366f1;
    border-radius: 10px;
    transition: border-color 0.3s;
  }

  #apropos .col-md-8 p:hover { border-left-color: #06b6d4; }

  /* ── SECTION COMPÉTENCES TITRE ── */
  #competences h3 {
    font-weight: 700;
    color: var(--text-pri);
  }

  #competences > .container > .text-center > p {
    color: var(--text-sec);
  }

  #competences .text-center.mt-5 > p {
    color: var(--text-sec);
    font-size: 0.93rem;
  }

  /* ── OVERFLOW image card (pour l'effet zoom) ── */
  .card { overflow: hidden; }

  /* ── CONTACT ── */
  #contacts .card-text { font-size: 0.9rem !important; word-break: break-all; }
</style>

