    </div>

    <div class="accordion-item">
      <h2 class="accordion-header" id="headingAC1106">
        <button class="accordion-button collapsed" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#collapseAC1106"
                aria-expanded="false"
                aria-controls="collapseAC1106">
          AC11.06 — Installation et documentation d'un poste client
        </button>
      </h2>
      <div id="collapseAC1106" class="accordion-collapse collapse"
           aria-labelledby="headingAC1106" data-bs-parent="#accordionAC">
