{% extends "base.html.twig" %}

{% block title %}SAE 1.02 - Administration des réseaux et documentation{% endblock %}

{% block body %}

<style>
  /* ── PAGE WRAPPER ── */
  .sae-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 60px 20px 80px;
  }

  /* ── HEADER HERO ── */
  .sae-hero {
    text-align: center;
    margin-bottom: 50px;
  }

  .sae-tag {
    display: inline-block;
    background: rgba(99,102,241,0.12);
    border: 1px solid rgba(99,102,241,0.3);
    color: #6366f1;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 5px 14px;
    border-radius: 50px;
    margin-bottom: 18px;
  }

  .sae-hero h1 {
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.5px;
    margin-bottom: 0;
  }

  /* ── ALERT INFO ── */
  .alert-info {
    background: rgba(6,182,212,0.08) !important;
    border: 1px solid rgba(6,182,212,0.25) !important;
    border-left: 4px solid #06b6d4 !important;
    border-radius: 12px !important;
    color: var(--text-sec) !important;
    padding: 20px 22px !important;
    font-size: 0.92rem;
    line-height: 1.7;
    margin-bottom: 40px;
  }

  .alert-info strong { color: #06b6d4; }

  /* ── SECTION TITLES ── */
  .section-label {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--text-pri);
    margin: 44px 0 18px;
    letter-spacing: -0.3px;
  }

  .section-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border-col);
  }

  /* ── ÉTAPES (ol) ── */
  ol.steps {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  ol.steps > li {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    background: var(--bg-card);
    border: 1px solid var(--border-col);
    border-radius: 12px;
    padding: 16px 18px;
    font-size: 0.9rem;
    color: var(--text-sec);
    line-height: 1.65;
    transition: border-color 0.25s, transform 0.25s;
    counter-increment: step-counter;
  }

  ol.steps > li:hover {
    border-color: var(--border-hover);
    transform: translateX(4px);
  }

  ol.steps > li::before {
    content: counter(step-counter);
    min-width: 28px;
    height: 28px;
    border-radius: 8px;
    background: linear-gradient(135deg, #6366f1, #06b6d4);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 1px;
  }

  ol.steps { counter-reset: step-counter; }

  ol.steps > li strong { color: var(--text-pri); }

  ol.steps ul {
    margin: 8px 0 0 4px;
    padding-left: 16px;
    list-style: disc;
    color: var(--text-sec);
    font-size: 0.85rem;
  }

  ol.steps ul li { margin-bottom: 3px; }

  /* ── ACCORDION ── */
  .accordion-item {
    background: var(--bg-card) !important;
    border: 1px solid var(--border-col) !important;
    border-radius: 12px !important;
    margin-bottom: 8px;
    overflow: hidden;
    transition: border-color 0.25s;
  }

  .accordion-item:hover { border-color: var(--border-hover) !important; }

  .accordion-button {
    background: var(--bg-card) !important;
    color: var(--text-pri) !important;
    font-weight: 600;
    font-size: 0.9rem;
    box-shadow: none !important;
    border: none !important;
  }

  .accordion-button:not(.collapsed) {
    background: rgba(99,102,241,0.07) !important;
    color: #6366f1 !important;
  }

  .accordion-button::after {
    filter: invert(40%) sepia(100%) saturate(500%) hue-rotate(210deg);
  }

  .accordion-body {
    background: var(--bg-card) !important;
    padding: 14px 20px 18px !important;
    border-top: 1px solid var(--border-col);
  }

  /* Boutons preuve / réflexive */
  .accordion-body .btn-outline-primary {
    border-radius: 8px;
    font-size: 0.82rem;
    font-weight: 600;
    padding: 6px 14px;
    transition: all 0.25s;
  }

  .accordion-body .btn-outline-secondary {
    border-radius: 8px;
    font-size: 0.82rem;
    font-weight: 600;
    padding: 6px 14px;
    transition: all 0.25s;
  }

  .accordion-body .btn-outline-primary:hover,
  .accordion-body .btn-outline-secondary:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(0,0,0,0.2);
  }

  /* ── LISTES CAHIER / CONSEILS ── */
  ul.styled-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  ul.styled-list li {
    background: var(--bg-card);
    border: 1px solid var(--border-col);
    border-radius: 10px;
    padding: 13px 16px 13px 44px;
    font-size: 0.89rem;
    color: var(--text-sec);
    line-height: 1.6;
    position: relative;
    transition: border-color 0.25s, transform 0.25s;
  }

  ul.styled-list li:hover {
    border-color: var(--border-hover);
    transform: translateX(4px);
  }

  ul.styled-list li::before {
    content: '→';
    position: absolute;
    left: 16px;
    color: #6366f1;
    font-weight: 700;
  }

  /* ── BOUTON RETOUR ── */
  .btn-retour {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 28px;
    border-radius: 12px;
    background: linear-gradient(135deg, #6366f1, #06b6d4);
    color: #fff !important;
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
    border: none;
    transition: all 0.25s;
    box-shadow: 0 4px 20px rgba(99,102,241,0.3);
  }

  .btn-retour:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 30px rgba(99,102,241,0.45);
    color: #fff !important;
  }
</style>

<div class="sae-page">

  <!-- HERO -->
  <div class="sae-hero" data-aos="fade-up">
    <div class="sae-tag">SAE 1.02</div>
    <h1>🌐 Administration des réseaux<br>et documentation</h1>
  </div>

  <!-- ALERT -->
  <div class="alert alert-info" data-aos="fade-up" data-aos-delay="80">
    <strong>Durée :</strong> 24 heures<br>
    <strong>Objectif :</strong> Concevoir, simuler et documenter un réseau local évolutif à partir d'une infrastructure existante.
  </div>

  <!-- ÉTAPES -->
  <div class="section-label" data-aos="fade-up">📚 Étapes du projet</div>
  <ol class="steps" data-aos="fade-up" data-aos-delay="60">
    <li>
      <div>
        <strong>Étude du réseau existant :</strong> Analyse des trames sniffées, exploration du protocole CDP, récupération des configurations via TFTP.
      </div>
    </li>
    <li>
      <div>
        <strong>Installation d'un serveur TFTP :</strong> Création d'un tutoriel d'installation de tftpd32/tftpd64 utilisable par tous.
      </div>
    </li>
    <li>
      <div>
        <strong>Conception et simulation :</strong> Création de 3 nouveaux LAN sur Packet Tracer :
        <ul>
          <li>LAN Production : 10 postes</li>
          <li>LAN Commerciaux : 5 postes</li>
          <li>LAN RH : 4 postes</li>
        </ul>
        Respect des contraintes VLAN (VLAN 150 réservé à l'administration).
      </div>
    </li>
    <li>
      <div>
        <strong>Réalisation et test :</strong> Mise en œuvre physique du réseau en salle TP avec tests sur Ubuntu.
      </div>
    </li>
    <li>
      <div>
        <strong>Document de synthèse :</strong> Rédaction d'un rapport complet justifiant la compatibilité du réseau existant avec les nouveaux LAN.
      </div>
    </li>
    <li>
      <div>
        <strong>Soutenance orale :</strong> Présentation de 7 minutes + 5 minutes de questions avec support diaporama.
      </div>
    </li>
  </ol>

  <!-- APPRENTISSAGES CRITIQUES -->
  <div class="section-label mt-5" data-aos="fade-up">🧠 Apprentissages critiques</div>

